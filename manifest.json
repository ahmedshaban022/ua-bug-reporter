{
  "manifest_version": 3,
  "name": "UA Bug Reporter",
  "short_name": "UA Bug Reporter",
  "version": "1.0.2",
  "description": "One click assembles a ready-to-paste bug report: page and environment info, console errors, failed network requests, and a screenshot — as markdown for your tracker.",
  "permissions": ["activeTab", "scripting", "storage", "contextMenus", "clipboardWrite"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "UA Bug Reporter (Alt+Shift+B to build a report)",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "build-report": {
      "suggested_key": {
        "default": "Alt+Shift+B"
      },
      "description": "Build a bug report from the current page"
    }
  }
}
